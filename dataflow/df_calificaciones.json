{
	"name": "df_calificaciones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "calificaciones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as string,",
				"          puntuacion as string,",
				"          comentario as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(fecha_calificacion = toDate(fecha_calificacion, 'yyyy-MM-dd'),",
				"          puntuacion = toInteger(puntuacion),",
				"          comentario = iif(length(trim(coalesce(comentario, ''))) == 0, 'Sin comentario', trim(comentario))) ~> derivedColumn1",
				"derivedColumn1 alterRow() ~> alterRow1"
			]
		}
	}
}